# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on
PORT=3000

# development or production (production enables Secure cookies and HSTS)
NODE_ENV=development

# Public address of the site, no trailing slash (used for sitemap.xml and Open Graph tags)
BASE_URL=http://localhost:3000

# Long random string (32+ characters). Generate one with: npm run hash-password
SESSION_SECRET=

# Admin login. There is no public registration page.
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate it with: npm run hash-password
# Keep the single quotes around the value.
ADMIN_PASSWORD_HASH=

# Only HTTPS product links on these hosts are accepted. Comma separated.
# "*.gumroad.com" allows any subdomain, for example yourname.gumroad.com
ALLOWED_GUMROAD_HOSTS=gumroad.com,*.gumroad.com,gum.co

# Shown on the Contact and About pages (optional)
SUPPORT_EMAIL=

# Number of reverse proxies in front of the app (0 for none, 1 for most hosts)
TRUST_PROXY=0

# Optional Gumroad "Ping" (webhook) support. See README, section 15.
# Leave empty to keep the webhook endpoint disabled.
GUMROAD_WEBHOOK_SECRET=
GUMROAD_SELLER_ID=
GUMROAD_ACCESS_TOKEN=
